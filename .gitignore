# 의존성
node_modules/
.pnp
.pnp.*

# Next.js 빌드 산출물.
# 앞에 /를 붙여 루트에만 건다 — 안 붙이면 어느 깊이든 같은 이름의 폴더가 걸려서
# src/tokens/build (구운 디자인 토큰)까지 함께 사라진다.
/.next/
/out/
/build/

# 환경변수 — 예시 파일(.env.example)까지 포함해 전부 올리지 않는다.
# 필요한 키 목록조차 저장소에 남기지 않겠다는 선택이다.
# (COLLECTOR_TOKEN, ADMIN_API_TOKEN, Supabase 키, ADMIN_ALLOWED_GITHUB_IDS)
.env
.env.*

# TypeScript 증분 캐시
*.tsbuildinfo

# next dev/build가 만드는 파일. .next/dev/types/*.d.ts 를 import 하는데
# 그 폴더는 위에서 무시되므로, 이 파일만 올리면 새로 clone 한 사람의
# `pnpm typecheck` 가 없는 모듈을 찾다 깨진다. Next가 알아서 다시 만든다.
next-env.d.ts

# 에디터·IDE
.idea/
.vscode/
*.swp

# 배포 플랫폼
.vercel

# 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 인증서·키 파일
*.pem
*.key

# OS
.DS_Store
Thumbs.db
